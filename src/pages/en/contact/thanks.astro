---
import Layout from '../../../layouts/Layout.astro';
import GlobalHeader from '../../../components/GlobalHeader.astro';
---

<Layout
  title="Thank You | Lumilinks inc."
  description="We have received your inquiry and will get back to you shortly, usually within three business days."
>
  <section class="pt-16">
    <GlobalHeader />
    <div class="grid grid-cols-1 gap-4 mb-8 pt-16">
      <h1 class="text-4xl sm:text-5xl font-normal mb-8">Thank You</h1>

      <div class="mb-8">
        <p class="mb-4">
          We have received your inquiry and will get back to you shortly.
        </p>
        <p class="mb-4">
          We usually reply within three business days. If you do not hear from
          us, please reach out via <a
            href="https://x.com/kgsi"
            class="underline hover:no-underline">social media</a
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>
