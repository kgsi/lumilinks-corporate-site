---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import NewsPostLayout from '../../../layouts/NewsPostLayout.astro';
import { newsSlug } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('newsEn');
  // 日本語版が存在する記事だけ、言語切替で同じ記事へ飛ばす
  const jaIds = new Set((await getCollection('news')).map((p) => p.id));
  return posts.map((post: CollectionEntry<'newsEn'>) => ({
    params: { slug: newsSlug(post.id) },
    props: { post, hasTranslation: jaIds.has(post.id) },
  }));
}

const { post, hasTranslation } = Astro.props as {
  post: CollectionEntry<'newsEn'>;
  hasTranslation: boolean;
};
const { Content } = await render(post);
---

<NewsPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  alternatePath={hasTranslation ? undefined : '/news'}
>
  <Content />
</NewsPostLayout>
