---
// ブラウザ標準の <dialog> を使ったモーダル。中身はスロットで渡す。
// ページ内の <a href="#id"> がクリックされると開き、URL が #id で開かれたときも最初から開く。
// <form method="dialog"> を含むので、<form> の外に置くこと（フォームは入れ子にできない）
import { t } from '../i18n/ui';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const { dialog } = t(Astro.currentLocale);
const titleId = `${id}-title`;
---

<!-- Tailwind v4 のリセットで dialog の margin: auto が消えるので m-auto で中央に戻す。
     高さの上限は画面の高さから上下の余白（スマホは 2rem ずつ、PC は 4rem ずつ）を引いたもの。
     背景色と文字色はブラウザ既定（Canvas / CanvasText）になるので明示する。
     closedby="any" は背景クリックで閉じる指定（未対応ブラウザ向けの代わりは下のスクリプト） -->
<dialog
  id={id}
  aria-labelledby={titleId}
  closedby="any"
  data-dialog
  class="m-auto w-[calc(100%-2rem)] max-w-2xl max-h-[calc(100dvh-4rem)] sm:max-h-[calc(100dvh-8rem)] flex-col open:flex overflow-hidden rounded-lg border border-black/10 dark:border-white/15 bg-white text-black dark:bg-neutral-900 dark:text-white shadow-2xl backdrop:bg-black/50"
>
  <div
    class="flex shrink-0 items-center justify-between gap-4 border-b border-black/10 dark:border-white/15 py-3 pl-6 pr-3"
  >
    <h2 id={titleId} class="text-lg sm:text-2xl font-semibold text-balance">
      {title}
    </h2>
    <form method="dialog">
      <button
        type="submit"
        aria-label={dialog.close}
        class="flex h-11 w-11 items-center justify-center rounded-full hover:bg-black/5 dark:hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </form>
  </div>

  <!-- 長い本文はここだけスクロールさせる。tabindex と autofocus で開いたときにここへフォーカスを移し、
       キーボードでもスクロールできるようにする（Safari はスクロール領域を自動でフォーカス対象にしない）。
       dialog の中の autofocus は、ページを開いたときではなく showModal() のときだけ効く -->
  <div
    tabindex="0"
    autofocus
    class="flex flex-col gap-6 overflow-y-auto overscroll-contain px-6 py-6 text-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500"
  >
    <slot />
  </div>

  <form
    method="dialog"
    class="flex shrink-0 justify-end border-t border-black/10 dark:border-white/15 px-6 py-4"
  >
    <button
      type="submit"
      class="px-8 py-2 text-lg bg-black text-white dark:text-black dark:bg-white hover:bg-gray-600 dark:hover:bg-gray-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-900"
    >
      {dialog.close}
    </button>
  </form>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>(
    'dialog[data-dialog]'
  )) {
    const open = () => {
      // 開いているダイアログに showModal() を呼ぶとエラーになる
      if (!dialog.open) dialog.showModal();
    };

    // 開くきっかけをボタンではなくリンクにしているのは、文中に置いても普通のリンクとして折り返すため
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      `a[href="#${dialog.id}"]`
    )) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      });
    }

    // 背景（::backdrop）のクリックで閉じる。closedby="any" が効かないブラウザ（Safari など）向けだが、
    // 閉じたダイアログに close() を呼んでも何も起きないので、対応ブラウザでもそのまま動かす。
    // 中で押して外で離したとき（文字を選択していたときなど）は閉じないよう、押した場所も見る
    let pressedOnBackdrop = false;
    dialog.addEventListener('pointerdown', (event) => {
      pressedOnBackdrop = event.target === dialog;
    });
    dialog.addEventListener('click', (event) => {
      if (pressedOnBackdrop && event.target === dialog) dialog.close();
    });

    // /contact#sales-terms のように直接リンクされたときは、開いた状態で始める
    if (location.hash === `#${dialog.id}`) open();
  }
</script>
