---
import GlobalFooter from '../components/GlobalFooter.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import { localizePath, resolveLocale, t } from '../i18n/ui';
import '../css/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * もう一方の言語に対応ページがない場合に指定する。
   * hreflang の alternate と言語切替の飛び先がこのパスになる。
   */
  alternatePath?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const dict = t(locale);

const {
  title = dict.defaultTitle,
  description = dict.defaultDescription,
  alternatePath,
} = Astro.props;

// hreflang 用に、日本語版と英語版それぞれの絶対URLを組み立てる
const site = Astro.site ?? new URL('https://lumilinks.jp');
const currentPath = Astro.url.pathname;
// 自分自身の言語は常に現在のURL、もう一方の言語だけ alternatePath（翻訳がない場合の行き先）を使う
const otherPath = alternatePath ?? currentPath;
const jaPath = locale === 'ja' ? currentPath : otherPath;
const enPath = locale === 'en' ? currentPath : otherPath;
// canonical やサイトマップと同じく末尾スラッシュ付きに揃える
const withTrailingSlash = (path: string) =>
  path.endsWith('/') ? path : `${path}/`;
const jaHref = new URL(withTrailingSlash(localizePath('ja', jaPath)), site)
  .href;
const enHref = new URL(withTrailingSlash(localizePath('en', enPath)), site)
  .href;
---

<!doctype html>
<html lang={locale} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Lumilinks" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={dict.siteName} />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:image" content="https://lumilinks.jp/ogp.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://lumilinks.jp/ogp.png" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="ja" href={jaHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={jaHref} />
    <!-- CSSは通常接続、woff2はCORS接続で取りに行くため両方を温めておく -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Gen Interface JP: 本文300 / font-normal 400 / font-semibold 600 のみ読み込む -->
    <link
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@0.8.0/cdn/300.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@0.8.0/cdn/400.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@0.8.0/cdn/600.css"
      rel="stylesheet"
    />
    <script
      is:inline
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-1R2H4VCDHH"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-1R2H4VCDHH');
    </script>
    <title>{title}</title>
    <script is:inline>
      // クライアントサイドでのテーマ初期化スクリプト
      const theme = (() => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body class="bg-white text-black dark:bg-black dark:text-white duration-300">
    <div
      class="box-content max-w-(--body-column) pr-(--body-padding-right) pl-(--body-padding-left) *:mx-auto *:w-[round(down,100%,1rem)]"
    >
      <slot />
      <GlobalFooter />
    </div>
    <FloatingMenu />
  </body>
</html>
